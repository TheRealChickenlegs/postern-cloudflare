---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="home-layout">
				<img src="/underdeep.png" alt="Underdeep dungeon crawler artwork" />
				<div class="home-content">
					<h1>Hello, Dungeon Crawler!</h1>
					<p>
						Underdeep is a single-player dungeon crawler for iPhone and iPad, 
						in the tradition of the classic roguelikes. 
					</p>

					<p>
						<em>Fifty floors down, something waits.</em>
					</p>

					<p>
						Use the menu links above to nagivate to the pages you seek.
					</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
	}

	.home-layout {
		display: grid;
		grid-template-columns: minmax(240px, 424px) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}

	.home-layout img {
		display: block;
		width: 100%;
		height: auto;
	}

	.home-content {
		padding-top: 1rem;
	}

	@media (max-width: 720px) {
		.home-layout {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.home-layout img {
			max-width: 424px;
			margin: 0 auto;
		}

		.home-content {
			padding-top: 0;
		}
	}
</style>
